rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'gpetrone80@gmail.com';
    }
    function optionalText(field, max) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    match /config/site {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email != null;
    }

    // 2027 mailing list. Email is required; name, department, title and the
    // source tag (e.g. "fb-nov · 2027-page") are optional.
    match /notify2027/{docId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['email', 'at', 'src', 'firstName', 'lastName', 'department', 'title'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && optionalText('src', 100)
        && optionalText('firstName', 80)
        && optionalText('lastName', 80)
        && optionalText('department', 120)
        && optionalText('title', 120);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Attendee photos the organizers chose to show in the public 2026 Photo Album.
    match /featured/{docId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['url', 'path', 'name', 'at'])
        && request.resource.data.url is string && request.resource.data.url.size() <= 2000;
      allow delete: if isAdmin();
      allow update: if false;
    }
  }
}
